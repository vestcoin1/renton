{
  "name": "renton",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,admin -c blue,magenta \"npm run dev -w renton-web\" \"npm run dev -w renton-admin\"",
    "dev:web": "npm run dev -w renton-web",
    "dev:admin": "npm run dev -w renton-admin",
    "dev:mobile": "npm run start -w renton-mobile",
    "web:mobile": "npm run web -w renton-mobile",
    "build": "npm run build -w renton-web -w renton-admin",
    "start": "concurrently -n web,admin -c blue,magenta \"npm run start -w renton-web\" \"npm run start -w renton-admin\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify": "npm run verify -w renton-web",
    "dev:api": "npm run dev -w renton-api",
    "test:api": "npm run test -w renton-api",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "npm run prisma:generate -w renton-api",
    "db:migrate": "npm run prisma:migrate -w renton-api",
    "db:push": "npm run db:push -w renton-api",
    "db:seed": "npm run db:seed -w renton-api",
    "db:reset": "npm run db:reset -w renton-api",
    "db:studio": "npm run prisma:studio -w renton-api"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}


