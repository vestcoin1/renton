# Copy to apps/api/.env
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Docker Postgres (npm run db:up). For Supabase use the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/renton?schema=public"
# Used by `npm run test:api`; wiped on every run.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/renton_test?schema=public"

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"

# ─── Auth ───
# Supabase project URL: enables token verification via the project's JWKS (asymmetric signing keys) and Storage.
SUPABASE_URL=""
# Only for projects still on the legacy HS256 JWT secret (Project Settings → API → JWT secret).
SUPABASE_JWT_SECRET=""
# Server-only. Used for Storage signed URLs and `npm run supabase:setup`. Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=""

# Development sign-in without Supabase (POST /v1/dev/session). Must be false in production.
DEV_AUTH=true
DEV_AUTH_SECRET="local-dev-auth-secret-change-me-0123456789"
