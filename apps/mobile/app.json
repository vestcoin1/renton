{
  "expo": {
    "name": "Renton",
    "slug": "renton",
    "scheme": "renton",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.renton.app"
    },
    "android": {
      "package": "ng.renton.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}