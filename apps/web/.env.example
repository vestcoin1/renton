# Copy to .env.local when wiring up Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "supabase" to switch the data layer off mock data
NEXT_PUBLIC_DATA_SOURCE=mock
# Where the admin app (apps/admin) is deployed; /admin/** is proxied there. Defaults to http://localhost:3001.
ADMIN_URL=
